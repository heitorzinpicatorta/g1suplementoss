# ── Mercado Pago ──────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...seu-token-aqui...

# ── Supabase ───────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...sua-service-role-key...

# ── Admin ──────────────────────────────────────────────────────
ADMIN_USER=seu_usuario_admin
ADMIN_PASS=sua_senha_segura

# JWT_SECRET: string longa e aleatória — gere com o comando abaixo no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ou no Linux/Mac:
#   openssl rand -hex 32
JWT_SECRET=cole_aqui_a_string_gerada
